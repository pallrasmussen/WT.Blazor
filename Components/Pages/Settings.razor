@page "/internal/settings"
@layout Layout.InternalLayout
@rendermode InteractiveServer
@attribute [Authorize(Policy = Policies.SuperAdminAccess)]
@inject IPortalSettingsService PortalSettingsManager
@inject NavigationManager NavigationManager
@inject ILogger<Settings> Logger

<PageTitle>@AppText.Get("Settings") | @AppText.Get("HospitalService")</PageTitle>

<div class="internal-heading">
    <div>
        <h1>@AppText.Get("Settings")</h1>
        <p>@AppText.Get("SettingsIntro")</p>
    </div>
</div>

@if (isLoading)
{
    <div class="empty-state"><strong>@AppText.Get("Loading")</strong></div>
}
else
{
    <NavigationLock ConfirmExternalNavigation="hasUnsavedChanges" OnBeforeInternalNavigation="ConfirmNavigationAsync" />
    <section class="internal-card settings-card">
        <h2>@AppText.Get("FreshnessSettings")</h2>
        <p>@AppText.Get("FreshnessSettingsIntro")</p>
        <div class="settings-grid">
            <div>
                <label for="green-months">@AppText.Get("GreenThreshold")</label>
                <input id="green-months" type="number" min="1" max="24" @bind="settings.GreenMaximumAgeMonths" />
                <small>@AppText.Get("GreenThresholdHint")</small>
            </div>
            <div>
                <label for="yellow-months">@AppText.Get("YellowThreshold")</label>
                <input id="yellow-months" type="number" min="2" max="36" @bind="settings.YellowMaximumAgeMonths" />
                <small>@AppText.Get("YellowThresholdHint")</small>
            </div>
            <div>
                <label>@AppText.Get("RedThreshold")</label>
                <p class="setting-readonly">@string.Format(AppText.Get("RedThresholdHint"), settings.YellowMaximumAgeMonths)</p>
            </div>
            <div>
                <label for="expiry-months">@AppText.Get("EstimateExpiryMonths")</label>
                <input id="expiry-months" type="number" min="1" max="60" @bind="settings.EstimateExpiryMonths" />
                <small>@AppText.Get("EstimateExpiryHelp")</small>
            </div>
        </div>
    </section>

    <section class="internal-card settings-card">
        <h2>@AppText.Get("PatientGuidanceSettings")</h2>
        <p>@AppText.Get("PatientGuidanceApprovalHelp")</p>
        <div class="settings-grid">
            <div><label for="referral-fo">@AppText.Get("ReferralInstructionsFo")</label><textarea id="referral-fo" maxlength="@FieldLimits.PatientGuidance" rows="5" @bind="settings.ReferralInstructionsFo"></textarea></div>
            <div><label for="referral-en">@AppText.Get("ReferralInstructionsEn")</label><textarea id="referral-en" maxlength="@FieldLimits.PatientGuidance" rows="5" @bind="settings.ReferralInstructionsEn"></textarea></div>
            <div><label for="contact-fo">@AppText.Get("ContactGuidanceFo")</label><textarea id="contact-fo" maxlength="@FieldLimits.PatientGuidance" rows="5" @bind="settings.ContactGuidanceFo"></textarea></div>
            <div><label for="contact-en">@AppText.Get("ContactGuidanceEn")</label><textarea id="contact-en" maxlength="@FieldLimits.PatientGuidance" rows="5" @bind="settings.ContactGuidanceEn"></textarea></div>
        </div>
        <label for="publish-guidance"><input id="publish-guidance" type="checkbox" @bind="settings.PublishPatientGuidance" /> @AppText.Get("PublishApprovedGuidance")</label>
    </section>

    <section class="internal-card settings-card">
        <h2>@AppText.Get("Operations")</h2>
        <p>@AppText.Get("OperationsSettingsIntro")</p>
        <div class="settings-grid">
            <div>
                <label for="long-wait-months">@AppText.Get("LongWaitThreshold")</label>
                <input id="long-wait-months" type="number" min="1" max="60" @bind="settings.LongWaitMonths" />
                <small>@AppText.Get("LongWaitThresholdHint")</small>
            </div>
        </div>
        @if (errorMessage is not null)
        {
            <p class="login-error" role="alert">@errorMessage</p>
            @if (hasConflict)
            {
                <p>@AppText.Get("ReloadLatestHint")</p>
                <button type="button" class="btn-secondary reload-settings" @onclick="ReloadAsync" disabled="@isSaving">@AppText.Get("ReloadLatest")</button>
            }
        }
        @if (statusMessage is not null)
        {
            <p class="status-banner" role="status">@statusMessage</p>
        }
        @if (hasUnsavedChanges)
        {
            <p class="dirty-note" role="status">@AppText.Get("UnsavedChanges")</p>
        }
        <button type="button" class="btn-teal" @onclick="SaveAsync" disabled="@(isSaving || !hasUnsavedChanges)">@AppText.Get("SaveSettings")</button>
    </section>

    <section class="internal-card settings-card">
        <h2>@AppText.Get("SettingsAudit")</h2>
        @if (recentChanges.Count == 0)
        {
            <p>@AppText.Get("SettingsAuditEmpty")</p>
        }
        else
        {
            <ul class="settings-audit-list">
                @foreach (var change in recentChanges)
                {
                    <li>@string.Format(AppText.Get("SettingsAuditEntry"), change.Timestamp.ToLocalTime(), change.Username, change.OldGreenMaximumAgeMonths, change.NewGreenMaximumAgeMonths, change.OldYellowMaximumAgeMonths, change.NewYellowMaximumAgeMonths, change.OldLongWaitMonths, change.NewLongWaitMonths)
                        @if (change.OldEstimateExpiryMonths != change.NewEstimateExpiryMonths)
                        { <span> · @AppText.Get("EstimateExpiryMonths"): @change.OldEstimateExpiryMonths → @change.NewEstimateExpiryMonths</span> }
                        @if (change.OldPublishPatientGuidance != change.NewPublishPatientGuidance
                            || change.OldReferralInstructionsFo != change.NewReferralInstructionsFo || change.OldReferralInstructionsEn != change.NewReferralInstructionsEn
                            || change.OldContactGuidanceFo != change.NewContactGuidanceFo || change.OldContactGuidanceEn != change.NewContactGuidanceEn)
                        { <span> · @AppText.Get("PatientGuidanceAuditChanged")</span> }
                    </li>
                }
            </ul>
        }
    </section>

    @if (showNavigationWarning)
    {
        <section class="discard-confirmation settings-navigation-warning" role="alert">
            <span>@AppText.Get("UnsavedChanges")</span>
            <button type="button" class="btn-secondary" @onclick="KeepEditing">@AppText.Get("KeepEditing")</button>
            <button type="button" class="btn-danger" @onclick="DiscardAndContinue">@AppText.Get("DiscardChanges")</button>
        </section>
    }
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private PortalSettings settings = new();
    private PortalSettings savedSettings = new();
    private bool isLoading = true;
    private bool isSaving;
    private bool hasConflict;
    private string? errorMessage;
    private string? statusMessage;
    private string username = "";
    private IReadOnlyList<PortalSettingsAuditEntry> recentChanges = [];
    private string? pendingNavigation;
    private bool showNavigationWarning;
    private bool allowNavigation;
    private bool hasUnsavedChanges => settings.GreenMaximumAgeMonths != savedSettings.GreenMaximumAgeMonths
        || settings.EstimateExpiryMonths != savedSettings.EstimateExpiryMonths
        || settings.YellowMaximumAgeMonths != savedSettings.YellowMaximumAgeMonths
        || settings.LongWaitMonths != savedSettings.LongWaitMonths
        || settings.ReferralInstructionsFo != savedSettings.ReferralInstructionsFo
        || settings.ReferralInstructionsEn != savedSettings.ReferralInstructionsEn
        || settings.ContactGuidanceFo != savedSettings.ContactGuidanceFo
        || settings.ContactGuidanceEn != savedSettings.ContactGuidanceEn
        || settings.PublishPatientGuidance != savedSettings.PublishPatientGuidance;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
            username = (await AuthState).User.Identity?.Name ?? "";
        settings = await PortalSettingsManager.GetAsync();
        savedSettings = Copy(settings);
        recentChanges = await PortalSettingsManager.GetRecentChangesAsync();
        isLoading = false;
    }

    private async Task SaveAsync()
    {
        errorMessage = Validate();
        statusMessage = null;
        if (errorMessage is not null) return;

        isSaving = true;
        hasConflict = false;
        try
        {
            await PortalSettingsManager.SaveAsync(settings, username);
            savedSettings = Copy(settings);
            recentChanges = await PortalSettingsManager.GetRecentChangesAsync();
            statusMessage = AppText.Get("SettingsSaved");
        }
        catch (PortalSettingsConcurrencyException)
        {
            hasConflict = true;
            errorMessage = AppText.Get("SettingsConcurrencyConflict");
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Could not save portal settings for {Username}.", username);
            errorMessage = AppText.Get("SettingsSaveFailed");
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ReloadAsync()
    {
        isSaving = true;
        try
        {
            var latest = await PortalSettingsManager.GetAsync();
            var changes = await PortalSettingsManager.GetRecentChangesAsync();
            settings = latest;
            savedSettings = Copy(latest);
            recentChanges = changes;
            errorMessage = null;
            statusMessage = null;
            hasConflict = false;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Could not reload portal settings for {Username}.", username);
            errorMessage = AppText.Get("SettingsReloadFailed");
        }
        finally
        {
            isSaving = false;
        }
    }

    private string? Validate() => PortalSettingsValidation.Validate(settings) is { } error
        ? PortalSettingsValidationText.Message(error) : null;

    private Task ConfirmNavigationAsync(LocationChangingContext context)
    {
        if (!hasUnsavedChanges || allowNavigation)
            return Task.CompletedTask;

        context.PreventNavigation();
        pendingNavigation = context.TargetLocation;
        showNavigationWarning = true;
        return InvokeAsync(StateHasChanged);
    }

    private void KeepEditing() => showNavigationWarning = false;

    private void DiscardAndContinue()
    {
        var destination = pendingNavigation;
        pendingNavigation = null;
        showNavigationWarning = false;
        if (string.IsNullOrWhiteSpace(destination))
            return;

        allowNavigation = true;
        NavigationManager.NavigateTo(destination);
    }

    private static PortalSettings Copy(PortalSettings source) => new()
    {
        EstimateExpiryMonths = source.EstimateExpiryMonths,
        GreenMaximumAgeMonths = source.GreenMaximumAgeMonths,
        YellowMaximumAgeMonths = source.YellowMaximumAgeMonths,
        LongWaitMonths = source.LongWaitMonths,
        ReferralInstructionsFo = source.ReferralInstructionsFo,
        ReferralInstructionsEn = source.ReferralInstructionsEn,
        ContactGuidanceFo = source.ContactGuidanceFo,
        ContactGuidanceEn = source.ContactGuidanceEn,
        PublishPatientGuidance = source.PublishPatientGuidance,
        Version = source.Version
    };
}