@page "/"
@layout Layout.PublicLayout
@rendermode InteractiveServer
@implements IDisposable
@using WT.Blazor.Components.Shared
@inject IWaitingTimeCatalogService WaitingTimeCatalog
@inject ITrendReadService TrendReader
@inject IPortalSettingsService PortalSettingsReader
@inject PortalSettingsChangeNotifier PortalSettingsNotifier
@inject TimeProvider TimeProvider
@inject NavigationManager NavigationManager
@inject ILogger<Home> Logger
@inject PortalTelemetry Telemetry

<PageTitle>@AppText.Get("WaitingTime") | @AppText.Get("HospitalService")</PageTitle>

<section class="public-hero">
	<h1>@AppText.Get("WaitingTime")</h1>
	<p>@AppText.Get("Intro")</p>
    <p>@AppText.Get("ReferralEstimateDisclaimer")</p>
</section>

<section class="public-panel public-large-text" aria-label="@AppText.Get("WaitingTime")" aria-busy="@isLoading">
	<div class="home-filter-presets">
		<AdminFilterPresets SelectedPreset="@selectedPreset" PresetSelected="ApplyPresetAsync" IncludeReview="false" />
	</div>

	<div class="results-toolbar public-utilities">
		<div class="browse-actions">
			@if (hasSearched)
			{
				<div class="browse-search">
					<label class="visually-hidden" for="search">@AppText.Get("Search")</label>
					<input id="search" type="search" @bind="searchText" @bind:event="oninput" @bind:after="UpdateUrl" placeholder="@AppText.Get("SearchPlaceholder")" />
				</div>
			}
			@if (HasActiveFilters)
			{
				<button type="button" class="filter-reset" @onclick="ClearFilters">@AppText.Get("ClearFilters")</button>
			}
		</div>
	</div>
    @if (loadFailed)
    {
        <p class="login-error" role="alert">@AppText.Get("RefreshFailed")</p>
    }
	<p class="print-summary">@string.Format(AppText.Get("PrintContext"), ScopeText, visibleItems.Count, TimeProvider.GetLocalNow())</p>

	@if (isLoading && items.Count == 0)
	{
		<div class="waiting-grid" aria-label="@AppText.Get("Loading")">
			@for (var index = 0; index < 3; index++)
			{
				<div class="waiting-card waiting-card-skeleton" aria-hidden="true">
					<span></span><strong></strong><i></i><em></em>
				</div>
			}
		</div>
	}
	else if (!hasSearched)
	{
		<div class="empty-state">
			<strong>@AppText.Get("ChooseWaitingTimeScope")</strong>
			<span>@AppText.Get("ChooseWaitingTimeScopeHint")</span>
		</div>
	}
	else if (visibleItems.Count == 0)
	{
		<div class="empty-state">
			<strong>@AppText.Get("NoResults")</strong>
			<span>@AppText.Get("ChangeFilters")</span>
		</div>
	}
	else
	{
		<div class="card-list-actions">
			<details class="card-indicator-help public-legend">
				<summary class="public-legend-trigger">@AppText.Get("ExplainIndicators")</summary>
				<div id="public-indicator-legend" class="public-legend-tooltip">
					<div class="trend-legend" aria-label="@AppText.Get("TrendLegend")">
						<span><i class="trend-arrow trend-up" aria-hidden="true"></i> @AppText.Get("TrendIncreasingSincePrevious")</span>
						<span><i class="trend-arrow trend-down" aria-hidden="true"></i> @AppText.Get("TrendDecreasingSincePrevious")</span>
						<span><i class="trend-arrow trend-flat" aria-hidden="true"></i> @AppText.Get("TrendUnchangedSincePrevious")</span>
					</div>
					<div class="freshness-legend" aria-label="@AppText.Get("FreshnessLegend")">
						<span><i class="status-dot status-fresh" aria-hidden="true"></i>@AppText.Get("FreshnessCurrent")</span>
						<span><i class="status-dot status-warning" aria-hidden="true"></i>@AppText.Get("FreshnessReview")</span>
						<span><i class="status-dot status-old" aria-hidden="true"></i>@AppText.Get("FreshnessOverdue")</span>
					</div>
				</div>
			</details>
			@if (!isLoading)
			{
				<button type="button" class="print-results" onclick="window.print()" title="@AppText.Get("PrintResults")"><span class="print-icon" aria-hidden="true">&#128424;</span><span>@AppText.Get("Print")</span></button>
			}
		</div>
		<h2 class="visually-hidden">@AppText.Get("WaitingTime")</h2>
        <div class="waiting-grid">
			@foreach (var item in visibleItems)
			{
				<article id="waiting-time-@item.Id" class="waiting-card">
					<div class="card-main">
						<span class="chip">@(item.Department is not null ? DisplayNames.For(item.Department.Value) : DisplayNames.For(item.Hospital))</span>
						<span class="card-hospital">@DisplayNames.For(item.Hospital)</span>
						<h3>@item.Name</h3>
                        <p class="referral-definition">@AppText.Get("ReferralEndpoint"): @ReferralEstimate.EndpointLabel(item.ReferralEndpoint)</p>
						<div class="wait-value @(item.EstimateStatus == EstimateStatus.Available && !ReferralEstimate.IsExpired(item, portalSettings, CurrentUtc) ? "" : "estimate-unavailable")">
                            @if (item.EstimateStatus == EstimateStatus.Available && !ReferralEstimate.IsExpired(item, portalSettings, CurrentUtc))
                            {
                                @(item.WaitUpperValue is { } upper ? $"{item.WaitValue}–{upper}" : item.WaitValue.ToString())
                                <span>@($" {DisplayNames.For(item.Unit, item.WaitUpperValue ?? item.WaitValue)}")</span>
                            }
                            else
                            {
                                @ReferralEstimate.PublicWaitText(item, portalSettings, CurrentUtc)
                            }
							@if (item.EstimateStatus == EstimateStatus.Available && !ReferralEstimate.IsExpired(item, portalSettings, CurrentUtc) && item.WaitUpperValue is null && trendChanges.TryGetValue(item.Id, out var change))
							{
								<span class="trend-arrow @TrendCssClass(change)" role="img" aria-label="@TrendLabel(change)" title="@TrendLabel(change)"></span>
							}
						</div>
					</div>
					@if (string.IsNullOrWhiteSpace(item.Note))
					{
						<p class="note note-empty" aria-hidden="true"></p>
					}
					else
					{
						<p class="note"><strong>@AppText.Get("ReferralConditions"):</strong> @item.Note</p>
					}
                    @if (ReferralEstimate.IsExpired(item, portalSettings, CurrentUtc))
                    { <p class="estimate-expired">@AppText.Get("EstimateExpiredContact")</p> }
                    @if (item.EstimateStatus == EstimateStatus.Available)
                    {
                        <a class="graph-link" href="@TrendUri(item.Id)">@AppText.Get("Trend")</a>
                        @if (item.VerifiedAt is { } verified)
                        {
                            <div class="updated-note @UpdatedStatus.CssClass(verified, portalSettings.GreenMaximumAgeMonths, portalSettings.YellowMaximumAgeMonths, CurrentUtc)">@AppText.Get("LastVerified"): @verified.ToLocalTime().ToString("dd. MMMM yyyy")</div>
                        }
                        else
                        {
                            <div class="updated-note">@AppText.Get("VerificationNotRecorded")</div>
                        }
                    }
				</article>
			}
		</div>
	}
	@if (isLoading && items.Count > 0)
	{
		<div class="results-loading" role="status" aria-live="polite">@AppText.Get("Loading")</div>
	}
</section>

<section class="waiting-time-guidance" aria-labelledby="waiting-time-guidance-heading">
	<h2 id="waiting-time-guidance-heading">@AppText.Get("WaitingTimeGuidanceHeading")</h2>
	<div class="guidance-grid">
		<article class="guidance-card">
			<h3>@AppText.Get("WaitingTimeMeaningHeading")</h3>
			<p>@AppText.Get("WaitingTimeMeaningText")</p>
		</article>
		<article class="guidance-card">
			<h3>@AppText.Get("WaitingTimeUpdateHeading")</h3>
			<p>@AppText.Get("WaitingTimeUpdateText")</p>
		</article>
	</div>
</section>

<HospitalComparisons Items="visibleItems" Settings="portalSettings" Now="CurrentUtc" />
<PatientNextSteps Settings="portalSettings" />

@code {
	private string selectedHospitalName = "";
	private string selectedDepartmentName = "";
	private string searchText = "";
	private string? selectedPreset = AllPreset;
	private const string AllPreset = "all";
	private const string SharedHospitalPreset = "shared";
	private const string NationalHospitalPreset = "national";
	private const string KlaksvikPreset = "klaksvik";
	private const string SuduroyPreset = "suduroy";
	[SupplyParameterFromQuery(Name = "hospital")] public string? QueryHospital { get; set; }
	[SupplyParameterFromQuery(Name = "department")] public string? QueryDepartment { get; set; }
	[SupplyParameterFromQuery(Name = "q")] public string? QuerySearch { get; set; }
	private bool hasSearched;
	private bool isLoading;
    private bool loadFailed;
    private bool disposed;
    private long loadVersion;
	private List<WaitingTime> items = [];
	private Dictionary<int, int> trendChanges = [];
	private PortalSettings portalSettings = new();
	private DateTime CurrentUtc => TimeProvider.GetUtcNow().UtcDateTime;
	private bool HasActiveFilters => !string.IsNullOrEmpty(selectedHospitalName)
		|| !string.IsNullOrWhiteSpace(searchText);
	private string ScopeText => string.IsNullOrEmpty(selectedHospitalName)
		? AppText.Get("AllWaitingTimes")
		: selectedDepartmentName == ""
				? selectedHospitalName
				: $"{selectedHospitalName}, {selectedDepartmentName}";

	private List<WaitingTime> visibleItems
	{
		get
		{
			var filtered = string.IsNullOrWhiteSpace(searchText)
				? items
				: items.Where(i => i.Name.Contains(searchText.Trim(), StringComparison.CurrentCultureIgnoreCase));
			return filtered.OrderBy(item => item.Name).ToList();
		}
	}

	private static string CountText(int n) => n == 1 ? $"1 {AppText.Get("WaitingTime").ToLowerInvariant()}" : $"{n} {AppText.Get("Results")}";
	private static string TrendCssClass(int change) => change switch { > 0 => "trend-up", < 0 => "trend-down", _ => "trend-flat" };
	private static string TrendLabel(int change) => change switch
	{
		> 0 => AppText.Get("TrendIncreasingSincePrevious"),
		< 0 => AppText.Get("TrendDecreasingSincePrevious"),
		_ => AppText.Get("TrendUnchangedSincePrevious")
	};

	protected override async Task OnInitializedAsync()
	{
		Hospital? hospital = Enum.TryParse<Hospital>(QueryHospital, out var parsedHospital)
			? parsedHospital
			: null;
		Department? department = hospital == Hospital.Landssjukrahusid
			&& Enum.TryParse<Department>(QueryDepartment, out var parsedDepartment)
			? parsedDepartment
			: null;
		if (hospital is not null) selectedHospitalName = DisplayNames.For(hospital.Value);
		if (department is not null) selectedDepartmentName = DisplayNames.For(department.Value);
		selectedPreset = PresetFor(hospital);
		searchText = QuerySearch ?? "";
		hasSearched = true;
		await LoadItemsAsync(hospital, department, source: "initial");
	}

	protected override void OnInitialized() => PortalSettingsNotifier.Changed += HandleSettingsChanged;

    private void HandleSettingsChanged(object? sender, EventArgs args) => _ = InvokeAsync(async () =>
    {
        await RefreshForSettingsChangeAsync();
        if (!disposed) StateHasChanged();
    });

    public void Dispose()
    {
        disposed = true;
        loadVersion++;
        PortalSettingsNotifier.Changed -= HandleSettingsChanged;
    }

	private async Task ClearFilters()
	{
		selectedHospitalName = "";
		selectedDepartmentName = "";
		searchText = "";
		selectedPreset = AllPreset;
		UpdateUrl();
		hasSearched = true;
		await LoadItemsAsync(null, null, clearResults: true, source: "filters-cleared");
	}

	private async Task ApplyPresetAsync(string preset)
	{
		selectedPreset = preset;
		selectedHospitalName = preset switch
		{
			SharedHospitalPreset => DisplayNames.For(Hospital.Sjukrahusverkid),
			NationalHospitalPreset => DisplayNames.For(Hospital.Landssjukrahusid),
			KlaksvikPreset => DisplayNames.For(Hospital.Klaksvikar),
			SuduroyPreset => DisplayNames.For(Hospital.Suduroyar),
			_ => ""
		};
		selectedDepartmentName = "";
		UpdateUrl();
		hasSearched = true;
		await LoadItemsAsync(DisplayNames.TryHospitalFrom(selectedHospitalName), null, clearResults: true, source: "preset");
	}

    private Task RefreshForSettingsChangeAsync() => LoadItemsAsync(
        DisplayNames.TryHospitalFrom(selectedHospitalName), DisplayNames.TryDepartmentFrom(selectedDepartmentName), source: "settings-change");

    private async Task LoadItemsAsync(Hospital? hospital, Department? department, bool clearResults = false, string source = "unknown")
    {
        if (disposed) return;
        var request = ++loadVersion;
        Telemetry.RecordPublicRefreshStarted(source);
        isLoading = true;
        loadFailed = false;
        if (clearResults)
        {
            items = [];
            trendChanges = [];
        }
        try
        {
            var loadedItems = await WaitingTimeCatalog.GetActiveAsync(hospital, department);
            if (disposed || request != loadVersion)
            {
                Telemetry.RecordPublicRefreshDiscarded(source);
                Logger.LogDebug("Discarded superseded public waiting-time refresh from {Source}.", source);
                return;
            }
            var loadedTrends = await TrendReader.GetTrendChangesAsync(loadedItems.Select(item => item.Id));
            if (disposed || request != loadVersion)
            {
                Telemetry.RecordPublicRefreshDiscarded(source);
                Logger.LogDebug("Discarded superseded public waiting-time refresh from {Source}.", source);
                return;
            }
            var loadedSettings = await PortalSettingsReader.GetAsync();
            if (disposed || request != loadVersion)
            {
                Telemetry.RecordPublicRefreshDiscarded(source);
                Logger.LogDebug("Discarded superseded public waiting-time refresh from {Source}.", source);
                return;
            }
            // Publish a complete result only if this is still the latest request.
            items = loadedItems;
            trendChanges = loadedTrends;
            portalSettings = loadedSettings;
            Telemetry.RecordPublicRefreshSucceeded(source);
            Logger.LogDebug("Completed public waiting-time refresh from {Source} with {ItemCount} items.", source, loadedItems.Count);
        }
        catch (Exception exception)
        {
            if (!disposed && request == loadVersion)
            {
                Telemetry.RecordPublicRefreshFailed(source);
                Logger.LogError(exception, "Could not load public waiting times from {Source}.", source);
                loadFailed = true;
            }
        }
        finally
        {
            if (!disposed && request == loadVersion) isLoading = false;
        }
    }

	private void UpdateUrl()
	{
		var hospital = DisplayNames.TryHospitalFrom(selectedHospitalName);
		var department = DisplayNames.TryDepartmentFrom(selectedDepartmentName);
		NavigationManager.NavigateTo(NavigationManager.GetUriWithQueryParameters(new Dictionary<string, object?>
		{
			["hospital"] = hospital?.ToString(),
			["department"] = department?.ToString(),
			["q"] = string.IsNullOrWhiteSpace(searchText) ? null : searchText.Trim()
		}), replace: true);
	}

	private static string PresetFor(Hospital? hospital) => hospital switch
	{
		Hospital.Sjukrahusverkid => SharedHospitalPreset,
		Hospital.Landssjukrahusid => NationalHospitalPreset,
		Hospital.Klaksvikar => KlaksvikPreset,
		Hospital.Suduroyar => SuduroyPreset,
		_ => AllPreset
	};

	private string TrendUri(int id)
	{
		var pathAndQuery = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
		var returnUrl = $"/{pathAndQuery}#waiting-time-{id}";
		return $"/gongd/{id}?returnUrl={Uri.EscapeDataString(returnUrl)}";
	}

}
