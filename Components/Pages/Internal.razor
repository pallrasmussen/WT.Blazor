@page "/internal"
@layout Layout.InternalLayout
@rendermode InteractiveServer
@attribute [Authorize(Policy = Policies.AdminAccess)]
@implements IDisposable
@using WT.Blazor.Components.Shared
@inject IWaitingTimeCatalogService WaitingTimeCatalog
@inject IWaitingTimeManagementService WaitingTimeManager
@inject IHistoryReadService HistoryReader
@inject IPortalSettingsService PortalSettingsReader
@inject PortalSettingsChangeNotifier PortalSettingsNotifier
@inject NavigationManager NavigationManager
@inject TimeProvider TimeProvider

<PageTitle>@AppText.Get("Administration") | @AppText.Get("HospitalService")</PageTitle>

<div class="internal-heading admin-heading">
    <div>
        <h1>@(showCreateForm ? AppText.Get("AdminHeadingCreate") : AppText.Get("AdminHeading"))</h1>
    </div>
    @if (isSuperAdmin && !showCreateForm)
    {
        <a class="btn-teal button-link" href="/internal?new=true">@AppText.Get("AddWaitingTime")</a>
    }
</div>

@if (!(isSuperAdmin && showCreateForm))
{
<section class="public-panel">
        <div class="admin-toolbar">
            <AdminFilterPresets SelectedPreset="@selectedPreset" PresetSelected="ApplyPresetAsync" />
            <div>
                <label for="admin-hospital">@AppText.Get("Hospital")</label>
                <select id="admin-hospital" @bind="filterHospital" @bind:after="FilterChangedAsync">
                    <option value="">@AppText.Get("AllWaitingLists")</option>
                    @foreach (var h in FilterHospitals)
                    {
                        <option value="@h">@(h == Hospital.Sjukrahusverkid ? AppText.Get("SharedWaitingLists") : DisplayNames.For(h))</option>
                    }
                </select>
            </div>
            @if (filterHospital == Hospital.Landssjukrahusid)
            {
                <div>
                    <label for="admin-dept">@AppText.Get("Department")</label>
                    <select id="admin-dept" @bind="filterDepartment" @bind:after="FilterChangedAsync">
                        <option value="">@AppText.Get("AllDepartments")</option>
                        @foreach (var d in AllDepartments)
                        {
                            <option value="@d">@DisplayNames.For(d)</option>
                        }
                    </select>
                </div>
            }
            <div>
                <label for="admin-search">@AppText.Get("SearchByName")</label>
                <input id="admin-search" @bind="searchText" @bind:event="oninput" placeholder="@AppText.Get("SearchPlaceholder")" />
            </div>
            <label class="review-filter" for="needs-review">
                <input id="needs-review" type="checkbox" @bind="showNeedsReview" @bind:after="FilterChangedAsync" />
                @string.Format(AppText.Get("NeedsReview"), items.Count(item => UpdatedStatus.RequiresReview(ReferralEstimate.ReviewDate(item), portalSettings.GreenMaximumAgeMonths, CurrentUtc)))
            </label>
            @if (isSuperAdmin)
            {
                <label class="review-filter" for="show-inactive">
                    <input id="show-inactive" type="checkbox" @bind="showInactive" @bind:after="FilterChangedAsync" />
                    @string.Format(AppText.Get("ShowInactive"), items.Count(item => !item.IsActive))
                </label>
            }
        </div>

        @if (showNeedsReview && visibleItems.Count > 0)
        {
            <ReviewQueueActions Count="visibleItems.Count" Confirming="confirmReviewAll" Busy="isReviewing" Confirm="ConfirmReviewAllAsync" Cancel="CancelReviewAll" Begin="BeginReviewAll" />
        }

        @if (statusMessage is not null)
        {
            <div class="status-banner" role="status" aria-live="polite">
                <span>@statusMessage</span>
                @if (pendingUndo is not null)
                {
                    <button class="btn-secondary" @onclick="UndoAsync">@AppText.Get("Undo")</button>
                }
            </div>
        }
    </section>
}

    @if (isSuperAdmin && showCreateForm)
    {
        <section class="create-box">
            <p>@AppText.Get("ReferralEstimateStaffHelp")</p>
            <div class="create-grid">
                <ReferralEstimateFields State="createForm" Prefix="new" Changed="StateHasChanged" />
                <div>
                    <label for="new-hospital">@AppText.Get("HistoryColumnHospital")</label>
                    <select id="new-hospital" @bind="createForm.HospitalName">
                        <option value="">@AppText.Get("ChooseHospital")</option>
                        @foreach (var h in EditableHospitals)
                        {
                            <option value="@DisplayNames.For(h)">@(h == Hospital.Sjukrahusverkid ? AppText.Get("SharedWaitingLists") : DisplayNames.For(h))</option>
                        }
                    </select>
                </div>
                @if (createForm.HospitalName == LandssjukrahusidName)
                {
                    <div>
                        <label for="new-department">@AppText.Get("Department")</label>
                        <select id="new-department" @bind="createForm.DepartmentName">
                            <option value="">@AppText.Get("ChooseDepartment")</option>
                            @foreach (var d in FormDepartments)
                            {
                                <option value="@d">@d</option>
                            }
                        </select>
                    </div>
                }
                <div>
                    <label for="new-name">@AppText.Get("SpecialtyTreatment")</label>
                    <input maxlength="200" id="new-name" @bind="createForm.Name" placeholder="@AppText.Get("SearchPlaceholder")" />
                </div>
                <div>
                    <label for="new-wait">@AppText.Get("Wait")</label>
                    <input id="new-wait" type="number" min="0" max="@WaitDuration.MaximumValue(createForm.Unit)" @bind="createForm.WaitValue" disabled="@(createForm.EstimateStatus != EstimateStatus.Available)" />
                </div>
                <div>
                    <label for="new-unit">@AppText.Get("Unit")</label>
                    <select id="new-unit" @bind="createForm.Unit" disabled="@(createForm.EstimateStatus != EstimateStatus.Available)">
                        <option value="@WaitUnit.Dagar">@AppText.Get("UnitDays")</option>
                        <option value="@WaitUnit.Vikur">@AppText.Get("UnitWeeks")</option>
                        <option value="@WaitUnit.Manadir">@AppText.Get("UnitMonths")</option>
                    </select>
                </div>
            </div>
            @if (createErrorMessage is not null)
            {
                <div class="login-error">@createErrorMessage</div>
            }
            <div style="margin-top:.8rem">
                <label for="new-note">@AppText.Get("ReferralConditions")</label>
                <input maxlength="500" id="new-note" @bind="createForm.Note" placeholder="@AppText.Get("Optional")" />
            </div>
            <button class="btn-teal" style="margin-top:.9rem" @onclick="AddNew" disabled="@isSaving">@AppText.Get("SaveNew")</button>
            <button type="button" class="btn-secondary" style="margin-top:.9rem" @onclick="CloseCreate">@AppText.Get("Cancel")</button>
        </section>
    }

    @if (!(isSuperAdmin && showCreateForm))
    {
        @if (isLoading)
        {
            <div class="empty-state">
                <strong>@AppText.Get("Loading")</strong>
            </div>
        }
        else if (visibleItems.Count == 0)
        {
            <div class="empty-state">
                <strong>@AppText.Get("NoWaitingTimes")</strong>
            </div>
        }
        else
        {
        <section class="admin-list" tabindex="0" @onkeydown="HandleReviewQueueKeyDown">
            @foreach (var item in visibleItems)
            {
                <article class="admin-row @(item.IsActive ? "" : "inactive")">
                    <div>
                        <h3>@item.Name</h3>
                        <div class="meta">
                            @DisplayNames.For(item.Hospital)@(item.Department is not null ? " · " + DisplayNames.For(item.Department.Value) : "")<br />
                            @if (item.EstimateStatus == EstimateStatus.Available && item.VerifiedAt is { } verified)
                            {
                                <span class="status-dot @UpdatedStatus.CssClass(verified, portalSettings.GreenMaximumAgeMonths, portalSettings.YellowMaximumAgeMonths, CurrentUtc)">@AppText.Get("LastVerified"): @verified.ToLocalTime().ToString("dd. MMMM yyyy")</span>
                            }
                            else
                            {
                                <span>@AppText.Get("VerificationNotRecorded")</span>
                            }
                            @if (!item.IsActive)
                            {
                                <br /><span class="inactive-meta">@AppText.Get("Inactive")</span>
                            }
                            @if (latestReviews.TryGetValue(item.Id, out var review))
                            {
                                <br /><span class="reviewed-meta">@string.Format(AppText.Get("ReviewedByAt"), review.Username ?? "-", review.Timestamp.ToLocalTime())</span>
                            }
                        </div>
                    </div>
                    <div>
                        <label>@AppText.Get("Wait")</label>
                        <div class="admin-value">@ReferralEstimate.WaitText(item)</div>
                        <small>@ReferralEstimate.EndpointLabel(item.ReferralEndpoint)</small>
                        <p>@AppText.Get("ResponsibleDepartment"): @(item.ResponsibleDepartment ?? AppText.Get("OwnerNotAssigned"))</p>
                    </div>
                    <div>
                        <label>@AppText.Get("ReferralConditions")</label>
                        <div class="admin-value">@(string.IsNullOrWhiteSpace(item.Note) ? "-" : item.Note)</div>
                    </div>
                    <div class="admin-actions">
                        @if (showNeedsReview)
                        {
                            <button class="btn-secondary" @onclick="() => MarkReviewedAsync(item)" disabled="@isReviewing">@AppText.Get("MarkReviewed")</button>
                        }
                        <button class="btn-teal" @onclick="() => OpenEdit(item)">@AppText.Get("Edit")</button>
                        @if (isSuperAdmin)
                        {
                            @if (item.IsActive)
                            {
                                <button class="btn-deactivate" @onclick="() => BeginDeactivation(item)">@AppText.Get("Deactivate")</button>
                            }
                            else
                            {
                                <button class="btn-teal" @onclick="() => ActivateAsync(item)">@AppText.Get("Activate")</button>
                            }
                        }
                    </div>
                    @if (quickEditItem?.Id == item.Id)
                    {
                        <div class="admin-quick-edit">
                            <ReferralEstimateFields State="quickEditForm" Changed="StateHasChanged" Prefix="@($"quick-{item.Id}")" IncludeDefinition="false" />
                            <div>
                                <label for="quick-wait-@item.Id">@AppText.Get("Wait")</label>
                                <input id="quick-wait-@item.Id" type="number" min="0" max="@WaitDuration.MaximumValue(quickEditForm.Unit)" @bind="quickEditForm.WaitValue" disabled="@(quickEditForm.EstimateStatus != EstimateStatus.Available)" />
                            </div>
                            <div>
                                <label for="quick-unit-@item.Id">@AppText.Get("Unit")</label>
                                <select id="quick-unit-@item.Id" @bind="quickEditForm.Unit" disabled="@(quickEditForm.EstimateStatus != EstimateStatus.Available)">
                                    <option value="@WaitUnit.Dagar">@AppText.Get("UnitDays")</option>
                                    <option value="@WaitUnit.Vikur">@AppText.Get("UnitWeeks")</option>
                                    <option value="@WaitUnit.Manadir">@AppText.Get("UnitMonths")</option>
                                </select>
                            </div>
                            <div>
                                <label for="quick-note-@item.Id">@AppText.Get("ReferralConditions")</label>
                                <input maxlength="500" id="quick-note-@item.Id" @bind="quickEditForm.Note" placeholder="@AppText.Get("Optional")" />
                            </div>
                            <div class="admin-quick-edit-actions">
                                <button class="btn-teal" @onclick="BeginQuickEditPreview" disabled="@isQuickSaving">@AppText.Get("SaveChanges")</button>
                                <button class="btn-secondary" @onclick="RequestCloseQuickEdit" disabled="@isQuickSaving">@AppText.Get("Cancel")</button>
                            </div>
                            @if (showQuickEditPreview)
                            {
                                <div class="change-preview" role="status">
                                    <strong>@AppText.Get("ChangePreview")</strong>
                                    <ul>
                                        @foreach (var change in QuickEditPreviewChanges())
                                        {
                                            <li>@change</li>
                                        }
                                    </ul>
                                    <button class="btn-teal" @onclick="SaveQuickEdit" disabled="@isQuickSaving">@AppText.Get("ConfirmSave")</button>
                                    <button class="btn-secondary" @onclick="CancelQuickEditPreview" disabled="@isQuickSaving">@AppText.Get("Cancel")</button>
                                </div>
                            }
                            @if (quickEditErrorMessage is not null)
                            {
                                <p class="login-error" role="alert">@quickEditErrorMessage</p>
                                @if (quickEditConflict)
                                {
                                    <p>@AppText.Get("ReloadLatestHint")</p>
                                    <button class="btn-secondary reload-latest" @onclick="() => ReloadConflictedItemAsync(true)">@AppText.Get("ReloadLatest")</button>
                                }
                            }
                            @if (confirmDiscardQuickEdit)
                            {
                                <div class="discard-confirmation">
                                    <span>@AppText.Get("UnsavedChanges")</span>
                                    <button class="btn-secondary" @onclick="CancelDiscardQuickEdit">@AppText.Get("KeepEditing")</button>
                                    <button class="btn-danger" @onclick="ConfirmDiscardQuickEdit">@AppText.Get("DiscardChanges")</button>
                                </div>
                            }
                        </div>
                    }
                </article>
            }
        </section>
        }
    }

    @if (editItem is not null)
    {
        <div class="modal-backdrop" @ref="editModalRef" @onkeydown="@(e => { if (e.Key == "Escape") RequestCloseEdit(); })" tabindex="-1">
            <div class="modal" @onclick:stopPropagation="true">
                <h2>@AppText.Get("EditWaitingTime")</h2>
                @if (editErrorMessage is not null)
                {
                    <div class="login-error" @ref="editErrorRef" role="alert" tabindex="-1">@editErrorMessage</div>
                    @if (editConflict)
                    {
                        <p>@AppText.Get("ReloadLatestHint")</p>
                        <button class="btn-secondary reload-latest" @onclick="() => ReloadConflictedItemAsync(false)">@AppText.Get("ReloadLatest")</button>
                    }
                }
                <p>@AppText.Get("ReferralEstimateStaffHelp")</p>
                <div class="edit-form-grid">
                    <ReferralEstimateFields State="editForm" Prefix="edit" Changed="StateHasChanged" />
                    @if (isSuperAdmin)
                    {
                    <div class="edit-form-field edit-form-field-wide">
                        <label for="edit-name">@AppText.Get("SpecialtyTreatment")</label>
                        <input id="edit-name" @bind="editForm.Name" />
                    </div>
                    <div class="edit-form-field">
                        <label for="edit-hospital">@AppText.Get("HistoryColumnHospital")</label>
                        <select id="edit-hospital" @bind="editForm.HospitalName">
                            @foreach (var h in EditableHospitals)
                            {
                                <option value="@DisplayNames.For(h)">@(h == Hospital.Sjukrahusverkid ? AppText.Get("SharedWaitingLists") : DisplayNames.For(h))</option>
                            }
                        </select>
                    </div>
                    @if (editForm.HospitalName == LandssjukrahusidName)
                    {
                        <div class="edit-form-field">
                            <label for="edit-department">@AppText.Get("Department")</label>
                            <select id="edit-department" @bind="editForm.DepartmentName">
                                <option value="">@AppText.Get("ChooseDepartment")</option>
                                @foreach (var d in FormDepartments)
                                {
                                    <option value="@d">@d</option>
                                }
                            </select>
                        </div>
                    }
                    }
                    <div class="edit-form-field">
                        <label for="edit-wait">@AppText.Get("Wait")</label>
                        <input id="edit-wait" type="number" min="0" max="@WaitDuration.MaximumValue(editForm.Unit)" @bind="editForm.WaitValue" disabled="@(editForm.EstimateStatus != EstimateStatus.Available)" />
                    </div>
                    <div class="edit-form-field">
                        <label for="edit-unit">@AppText.Get("Unit")</label>
                        <select id="edit-unit" @bind="editForm.Unit" disabled="@(editForm.EstimateStatus != EstimateStatus.Available)">
                            <option value="@WaitUnit.Dagar">@AppText.Get("UnitDays")</option>
                            <option value="@WaitUnit.Vikur">@AppText.Get("UnitWeeks")</option>
                            <option value="@WaitUnit.Manadir">@AppText.Get("UnitMonths")</option>
                        </select>
                    </div>
                    <div class="edit-form-field edit-form-field-wide">
                        <label for="edit-note">@AppText.Get("ReferralConditions")</label>
                        <input maxlength="500" id="edit-note" @bind="editForm.Note" placeholder="@AppText.Get("Optional")" />
                    </div>
                </div>
                @if (showEditPreview)
                {
                    <div class="change-preview" role="status">
                        <strong>@AppText.Get("ChangePreview")</strong>
                        <ul>
                            @foreach (var change in EditPreviewChanges())
                            {
                                <li>@change</li>
                            }
                        </ul>
                        <button class="btn-teal" @onclick="SaveEdit">@AppText.Get("ConfirmSave")</button>
                        <button class="btn-secondary" @onclick="CancelEditPreview">@AppText.Get("Cancel")</button>
                    </div>
                }
                <div class="modal-actions">
                    <button class="btn-secondary" @onclick="RequestCloseEdit">@AppText.Get("Cancel")</button>
                    <button class="btn-teal" @onclick="BeginEditPreview">@AppText.Get("SaveChanges")</button>
                </div>
                @if (confirmDiscardEdit)
                {
                    <div class="discard-confirmation">
                        <span>@AppText.Get("UnsavedChanges")</span>
                        <button class="btn-secondary" @onclick="CancelDiscardEdit">@AppText.Get("KeepEditing")</button>
                        <button class="btn-danger" @onclick="ConfirmDiscardEdit">@AppText.Get("DiscardChanges")</button>
                    </div>
                }
            </div>
        </div>
    }

    @if (itemPendingDeactivation is not null)
    {
        <DeactivateWaitingTimeModal Item="itemPendingDeactivation"
                                    Reason="@deactivationReason"
                                    ReasonChanged="@(value => deactivationReason = value)"
                                    ErrorMessage="@deactivationErrorMessage"
                                    Cancel="CancelDeactivation"
                                    Confirm="ConfirmDeactivationAsync" />
    }
