@page "/Error"
@layout Layout.PublicLayout
@using System.Diagnostics

<PageTitle>@AppText.Get("ApplicationError") | @AppText.Get("HospitalService")</PageTitle>

<section class="public-panel access-message">
    <h1>@AppText.Get("ApplicationError")</h1>
    <p>@AppText.Get("ApplicationErrorText")</p>
    @if (ShowRequestId)
    {
        <p class="error-request-id">@AppText.Get("ErrorRequestId"): <code>@RequestId</code></p>
    }
    <a class="btn-secondary" href="/">@AppText.Get("Back")</a>
</section>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
