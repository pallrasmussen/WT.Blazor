@using WT.Blazor.Services

@if (Points.Count < 2)
{
    <div class="empty-state">@AppText.Get("TrendNotEnoughData")</div>
}
else
{
    <div class="chart-wrap">
        <svg class="chart-svg" viewBox="0 0 820 320" role="img" aria-label="@AppText.Get("TrendChartLabel")">
            @((MarkupString)BuildSvgMarkup())
        </svg>
    </div>
    <details class="trend-data-table">
        <summary>@AppText.Get("TrendDataTable")</summary>
        <table>
            <thead><tr><th>@AppText.Get("Date")</th><th>@AppText.Get("Wait")</th></tr></thead>
            <tbody>
                @foreach (var point in Points)
                {
                    <tr><td>@point.Timestamp.ToString("dd.MM.yyyy")</td><td>@point.Value @UnitLabel</td></tr>
                }
            </tbody>
        </table>
    </details>
}

@code {
    [Parameter, EditorRequired] public List<TrendPoint> Points { get; set; } = [];
    [Parameter] public string UnitLabel { get; set; } = "";

    private const int Width = 820;
    private const int Height = 320;
    private const double MinimumDateLabelSpacing = 60;
    private static readonly (int L, int R, int T, int B) Pad = (62, 28, 20, 60);

    private double MinTicks => Points.Min(p => p.Timestamp.Ticks);
    private DateTime ChartEnd => DateTime.UtcNow.Date > Points[^1].Timestamp.Date
        ? DateTime.UtcNow.Date
        : Points[^1].Timestamp;
    private double MaxTicks => ChartEnd.Ticks == MinTicks ? ChartEnd.AddDays(1).Ticks : ChartEnd.Ticks;
    private double MinValue => 0;
    private double YAxisTickStep => Math.Max(1, Math.Ceiling((Points.Max(p => p.Value) + 1) / 4d));
    private double MaxValue => Math.Ceiling((Points.Max(p => p.Value) + YAxisTickStep) / YAxisTickStep) * YAxisTickStep;
    private int YAxisTickCount => (int)(MaxValue / YAxisTickStep);

    private double X(DateTime t)
    {
        var pw = Width - Pad.L - Pad.R;
        return Pad.L + (t.Ticks - MinTicks) / (MaxTicks - MinTicks) * pw;
    }

    private double Y(double value)
    {
        var ph = Height - Pad.T - Pad.B;
        return Pad.T + ph - (value - MinValue) / (MaxValue - MinValue) * ph;
    }

    private static string F(double v) => v.ToString(System.Globalization.CultureInfo.InvariantCulture);

    private string BuildSvgMarkup()
    {
        var sb = new System.Text.StringBuilder();

        for (var i = 0; i <= YAxisTickCount; i++)
        {
            var value = i * YAxisTickStep;
            var y = Y(value);
            sb.Append($"""<line x1="{Pad.L}" y1="{F(y)}" x2="{Width - Pad.R}" y2="{F(y)}" stroke="#e3e8eb" stroke-width="1"/>""");
            sb.Append($"""<text x="{Pad.L - 10}" y="{F(y + 4)}" text-anchor="end" font-size="11" fill="#667085">{F(value)}</text>""");
        }

        var d = new System.Text.StringBuilder($"M {F(X(Points[0].Timestamp))} {F(Y(Points[0].Value))}");
        for (var i = 1; i < Points.Count; i++)
        {
            d.Append($" L {F(X(Points[i].Timestamp))} {F(Y(Points[i].Value))}");
        }
        sb.Append($"""<path d="{d}" fill="none" stroke="#006b73" stroke-width="4" stroke-linejoin="round" stroke-linecap="round"/>""");

        if (ChartEnd > Points[^1].Timestamp)
        {
            var lastPoint = Points[^1];
            var y = Y(lastPoint.Value);
            sb.Append($"""<path class="chart-current-estimate" d="M {F(X(lastPoint.Timestamp))} {F(y)} H {F(X(ChartEnd))}" fill="none" stroke="#006b73" stroke-width="4" stroke-dasharray="6 5" stroke-linecap="round"/>""");
            sb.Append($"""<text class="chart-date-label" x="{F(X(ChartEnd))}" y="{Height - Pad.B + 24}" text-anchor="end" font-size="10.5" fill="#667085">{System.Net.WebUtility.HtmlEncode(AppText.Get("Current"))}</text>""");
        }

        var dateLabelIndices = DateLabelIndices();
        for (var index = 0; index < Points.Count; index++)
        {
            var p = Points[index];
            var x = X(p.Timestamp);
            var y = Y(p.Value);
            var pointLabel = System.Net.WebUtility.HtmlEncode($"{p.Timestamp:dd.MM.yyyy}: {p.Value} {UnitLabel}");
            sb.Append($"""<circle class="chart-point" cx="{F(x)}" cy="{F(y)}" r="5" fill="#fff" stroke="#006b73" stroke-width="3"><title>{pointLabel}</title></circle>""");
            if (dateLabelIndices.Contains(index))
                sb.Append($"""<text class="chart-date-label" x="{F(x)}" y="{Height - Pad.B + 24}" text-anchor="middle" font-size="10.5" fill="#667085">{p.Timestamp:dd.MM.yy}</text>""");
        }

        return sb.ToString();
    }

    private HashSet<int> DateLabelIndices()
    {
        var labelIndices = new List<int> { 0 };
        var lastIndex = Points.Count - 1;

        for (var index = 1; index < lastIndex; index++)
        {
            if (X(Points[index].Timestamp) - X(Points[labelIndices[^1]].Timestamp) >= MinimumDateLabelSpacing)
                labelIndices.Add(index);
        }

        while (labelIndices.Count > 0 &&
               X(Points[lastIndex].Timestamp) - X(Points[labelIndices[^1]].Timestamp) < MinimumDateLabelSpacing)
        {
            labelIndices.RemoveAt(labelIndices.Count - 1);
        }

        var currentLabelWouldOverlap = ChartEnd > Points[lastIndex].Timestamp &&
                                       X(ChartEnd) - X(Points[lastIndex].Timestamp) < MinimumDateLabelSpacing;
        if (!currentLabelWouldOverlap)
            labelIndices.Add(lastIndex);

        return labelIndices.ToHashSet();
    }
}
