<div class="review-queue">
    <span>@string.Format(AppText.Get("ReviewQueue"), Count)</span>
    <span class="review-queue-hint">@AppText.Get("ReviewQueueKeyboardHint")</span>
    @if (Confirming)
    {
        <button class="btn-teal" @onclick="Confirm" disabled="@Busy">@AppText.Get("ConfirmReviewAll")</button>
        <button class="btn-secondary" @onclick="Cancel" disabled="@Busy">@AppText.Get("Cancel")</button>
    }
    else
    {
        <button class="btn-secondary" @onclick="Begin">@AppText.Get("ReviewAll")</button>
    }
</div>

@code {
    [Parameter] public int Count { get; set; }
    [Parameter] public bool Confirming { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback Confirm { get; set; }
    [Parameter] public EventCallback Cancel { get; set; }
    [Parameter] public EventCallback Begin { get; set; }
}
