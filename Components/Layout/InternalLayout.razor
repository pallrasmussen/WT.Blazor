@inherits LayoutComponentBase
@inject Microsoft.Extensions.Options.IOptions<AdGroupsOptions> AdGroupsOptions
@inject NavigationManager NavigationManager
@inject Microsoft.Extensions.Diagnostics.HealthChecks.HealthCheckService HealthChecks
@inject TimeProvider TimeProvider
@implements IDisposable

<div class="internal-shell">
    <a class="skip-link" href="#internal-content">@AppText.Get("SkipToContent")</a>
    <header class="internal-header">
        <a class="brand" href="/" aria-label="@AppText.Get("HospitalService")">
            <img src="/images/Sj%C3%BAkrah%C3%BAsverki%20logo.png" alt="" />
        </a>
        @if (!string.IsNullOrEmpty(userName))
        {
            <div class="internal-header-status">
                <a class="internal-health @(isHealthy ? "healthy" : "unhealthy")" href="/internal/operations" aria-label="@AppText.Get("SystemStatus")" title="@(isHealthy ? AppText.Get("DatabaseHealthy") : AppText.Get("DatabaseUnverified"))">
                    <span class="internal-health-indicator" aria-hidden="true"></span><span class="internal-health-label">@(isHealthy ? AppText.Get("SystemHealthy") : AppText.Get("CheckSystem"))</span>
                </a>
                <span class="internal-user">
                    <span class="internal-badge">@userName</span>
                    <span class="internal-role">@(isSuperAdmin ? AppText.Get("SuperAdministrator") : AppText.Get("Administrator"))</span>
                </span>
            </div>
        }
    </header>
    <button class="internal-nav-toggle" type="button" aria-controls="internal-navigation" aria-expanded="@(navigationOpen ? "true" : "false")" @onclick="ToggleNavigation">
        @AppText.Get("NavigationMenu")
    </button>
    <div class="internal-body">
        <nav id="internal-navigation" class="internal-nav @(navigationOpen ? "open" : "")" aria-label="@AppText.Get("InternalNavigation")">
            <a href="/" class="internal-nav-back"><span aria-hidden="true">&larr;</span>@AppText.Get("Back")</a>
            <div class="internal-nav-group">
                <span class="internal-nav-label">@AppText.Get("WaitingTimesNavigation")</span>
                <a href="/internal" class="@(IsWaitingTimesRoute ? "active" : "")" aria-current="@(IsWaitingTimesRoute ? "page" : null)">@AppText.Get("EditWaitingTimes")</a>
            </div>
            <div class="internal-nav-group">
                <span class="internal-nav-label">@AppText.Get("AdministrationToolsNavigation")</span>
                <a href="/internal/history" class="@(IsHistoryRoute ? "active" : "")" aria-current="@(IsHistoryRoute ? "page" : null)">@AppText.Get("History")</a>
                <a href="/internal/operations" class="@(IsOperationsRoute ? "active" : "")" aria-current="@(IsOperationsRoute ? "page" : null)">@AppText.Get("Operations")</a>
                @if (isSuperAdmin)
                {
                    <a href="/internal/settings" class="@(IsSettingsRoute ? "active" : "")" aria-current="@(IsSettingsRoute ? "page" : null)">@AppText.Get("Settings")</a>
                }
            </div>
        </nav>
        <main id="internal-content" class="internal-content" tabindex="-1">
            @Body
        </main>
    </div>
    <SiteFooter />
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private string userName = "";
    private bool isSuperAdmin;
    private bool isHealthy;
    private DateTime healthCheckedAt;
    private string AdminGroup => AdGroupsOptions.Value.Admin;
    private string CurrentPath => new Uri(NavigationManager.Uri).AbsolutePath.TrimEnd('/');
    private bool IsWaitingTimesRoute => string.Equals(CurrentPath, "/internal", StringComparison.OrdinalIgnoreCase);
    private bool IsHistoryRoute => CurrentPath.StartsWith("/internal/history", StringComparison.OrdinalIgnoreCase);
    private bool IsOperationsRoute => CurrentPath.StartsWith("/internal/operations", StringComparison.OrdinalIgnoreCase);
    private bool IsSettingsRoute => CurrentPath.StartsWith("/internal/settings", StringComparison.OrdinalIgnoreCase);
    private bool navigationOpen;

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += HandleLocationChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var state = await AuthState;
            userName = state.User.Identity?.Name ?? "";
            isSuperAdmin = Policies.IsSuperAdmin(state.User, AdminGroup);
        }

        try
        {
            isHealthy = (await HealthChecks.CheckHealthAsync()).Status == Microsoft.Extensions.Diagnostics.HealthChecks.HealthStatus.Healthy;
        }
        catch
        {
            isHealthy = false;
        }
        healthCheckedAt = TimeProvider.GetLocalNow().DateTime;
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args) => _ = InvokeAsync(() =>
    {
        navigationOpen = false;
        StateHasChanged();
    });

    private void ToggleNavigation() => navigationOpen = !navigationOpen;

    public void Dispose() => NavigationManager.LocationChanged -= HandleLocationChanged;
}
