@inherits LayoutComponentBase
@inject Microsoft.Extensions.Options.IOptions<AdGroupsOptions> AdGroupsOptions
@inject NavigationManager NavigationManager
@inject Microsoft.Extensions.Diagnostics.HealthChecks.HealthCheckService HealthChecks
@inject TimeProvider TimeProvider
@implements IDisposable

<div class="internal-shell">
    <a class="skip-link" href="#internal-content">@AppText.Get("SkipToContent")</a>
    <header class="internal-header">
        <a class="brand" href="/" aria-label="@AppText.Get("HospitalService")">
            <img src="/images/Sj%C3%BAkrah%C3%BAsverki%20logo.png" alt="" />
        </a>
        @if (!string.IsNullOrEmpty(userName))
        {
            <div class="internal-header-status">
                <a class="internal-health @(isHealthy ? "healthy" : "unhealthy")" href="/internal/operations" title="@(isHealthy ? AppText.Get("DatabaseHealthy") : AppText.Get("DatabaseUnverified"))">
                    <span aria-hidden="true"></span>@(isHealthy ? string.Format(AppText.Get("SystemHealthyAt"), healthCheckedAt) : AppText.Get("CheckSystem"))
                </a>
                <span class="internal-user">
                    <span class="internal-badge">@userName</span>
                    <span class="internal-role">@(isSuperAdmin ? AppText.Get("SuperAdministrator") : AppText.Get("Administrator"))</span>
                </span>
            </div>
        }
    </header>
    <div class="internal-body">
        <aside class="internal-nav">
            <a href="/" class="internal-nav-back"><span aria-hidden="true">&larr;</span>@AppText.Get("Back")</a>
            <span class="internal-nav-divider" aria-hidden="true"></span>
            <a href="/internal" class="@(IsWaitingTimesRoute ? "active" : "")">@AppText.Get("EditWaitingTimes")</a>
            @if (isSuperAdmin)
            {
                <a href="/internal?new=true" class="@(IsCreateRoute ? "active" : "")">@AppText.Get("AddWaitingTime")</a>
            }
            <span class="internal-nav-divider" aria-hidden="true"></span>
            <a href="/internal/history" class="@(IsHistoryRoute ? "active" : "")">@AppText.Get("History")</a>
            <a href="/internal/operations" class="@(IsOperationsRoute ? "active" : "")">@AppText.Get("Operations")</a>
            @if (isSuperAdmin)
            {
                <a href="/internal/settings" class="@(IsSettingsRoute ? "active" : "")">@AppText.Get("Settings")</a>
            }
        </aside>
        <main id="internal-content" class="internal-content" tabindex="-1">
            @Body
        </main>
    </div>
    <SiteFooter />
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private string userName = "";
    private bool isSuperAdmin;
    private bool isHealthy;
    private DateTime healthCheckedAt;
    private string AdminGroup => AdGroupsOptions.Value.Admin;
    private string CurrentRoute => NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
    private bool IsWaitingTimesRoute => string.Equals(CurrentRoute, "internal", StringComparison.OrdinalIgnoreCase);
    private bool IsHistoryRoute => CurrentRoute.StartsWith("internal/history", StringComparison.OrdinalIgnoreCase);
    private bool IsOperationsRoute => CurrentRoute.StartsWith("internal/operations", StringComparison.OrdinalIgnoreCase);
    private bool IsSettingsRoute => CurrentRoute.StartsWith("internal/settings", StringComparison.OrdinalIgnoreCase);
    private bool IsCreateRoute => CurrentRoute.StartsWith("internal?new=true", StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += HandleLocationChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var state = await AuthState;
            userName = state.User.Identity?.Name ?? "";
            isSuperAdmin = Policies.IsSuperAdmin(state.User, AdminGroup);
        }

        try
        {
            isHealthy = (await HealthChecks.CheckHealthAsync()).Status == Microsoft.Extensions.Diagnostics.HealthChecks.HealthStatus.Healthy;
        }
        catch
        {
            isHealthy = false;
        }
        healthCheckedAt = TimeProvider.GetLocalNow().DateTime;
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args) => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => NavigationManager.LocationChanged -= HandleLocationChanged;
}
