{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=App_Data/wt-blazor.db;Default Timeout=30"
  },
  "AdGroups": {
    "Viewer": "",
    "Contributor": "",
    "Admin": ""
  },
  "Backup": {
    "Path": "App_Data\\backups"
  },
  "AuditRetention": {
    "ReviewAfterDays": 3650
  },
  "Exports": {
    "MaximumHistoryRows": 10000,
    "MaximumTrendPoints": 1000,
    "TemporaryPath": "App_Data\\export-temp",
    "TemporaryFileRetentionHours": 24,
    "TemporaryFileCleanupIntervalHours": 1
  },
  "Hosting": {
    "RedirectToHttps": true
  },
  "OpenTelemetry": {
    "OtlpEndpoint": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "App_Data/logs/wt-blazor-.log",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "fileSizeLimitBytes": 10485760,
          "retainedFileCountLimit": 30,
          "shared": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "localhost"
}
